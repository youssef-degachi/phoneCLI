{
    "name": "client",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently --raw --kill-others-on-fail \"pnpm dev:next\" \"pnpm dev:tunnel\"",
        "dev:next": "cross-env NODE_OPTIONS=--no-experimental-webstorage next dev -p 4000",
        "dev:tunnel": "node scripts/start-tunnel.mjs",
        "build": "next build",
        "start": "cross-env NODE_OPTIONS=--no-experimental-webstorage next start -p 4000",
        "lint": "next lint"
    },
    "dependencies": {
        "next": "15.3.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "next-themes": "^0.4.6",
        "axios": "^1.7.9",
        "lucide-react": "^0.488.0",
        "clsx": "^2.1.1",
        "tailwind-merge": "^2.6.0",
        "framer-motion": "^12.6.3",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0",
        "@radix-ui/react-slot": "^1.2.2",
        "class-variance-authority": "^0.7.1"
    },
    "devDependencies": {
        "typescript": "^5",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "tailwindcss": "^3.4.17",
        "postcss": "^8",
        "autoprefixer": "^10.4.20",
        "eslint": "^8",
        "eslint-config-next": "15.3.1",
        "concurrently": "^9.1.0",
        "cross-env": "^7.0.3"
    }
}